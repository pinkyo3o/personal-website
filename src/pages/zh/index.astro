---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';
import { siteConfig } from '../../data/site';
import { getFeaturedProjects } from '../../data/projects';

const lang = getLangFromUrl(Astro.url) as 'zh' | 'en';
const t = useTranslations(lang);

// 获取最新的 3 篇博客文章
const posts = (await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = getFeaturedProjects();
const name = siteConfig.name.zh;
const tagline = siteConfig.tagline.zh;
---

<BaseLayout title={`${name} · ${tagline}`} description={tagline}>
  <!-- Hero 区 -->
  <section class="relative overflow-hidden">
    <!-- 装饰圆点 -->
    <div class="absolute top-10 left-10 w-72 h-72 bg-coral/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-mint/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-32 text-center">
      <!-- 浮动 emoji -->
      <div class="text-6xl mb-6 animate-float">👋</div>

      <!-- 问候语 -->
      <p class="text-lg text-ink-soft mb-2">{t('home.greeting')}</p>

      <!-- 名字 -->
      <h1 class="text-5xl sm:text-7xl font-extrabold gradient-text mb-6">
        {name}
      </h1>

      <!-- 标语 -->
      <p class="text-xl sm:text-2xl text-ink-soft max-w-2xl mx-auto mb-4">
        {tagline}
      </p>

      <!-- 欢迎语 -->
      <p class="text-base text-ink-soft/70 mb-12">
        {t('home.welcome')}
      </p>

      <!-- 快速导航卡片 -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/zh/blog" class="px-6 py-3 rounded-2xl bg-coral text-white font-semibold shadow-lg shadow-coral/30 hover:shadow-xl hover:shadow-coral/40 hover:-translate-y-0.5 transition-all">
          ✍️ {t('nav.blog')}
        </a>
        <a href="/zh/projects" class="px-6 py-3 rounded-2xl bg-mint text-white font-semibold shadow-lg shadow-mint/30 hover:shadow-xl hover:shadow-mint/40 hover:-translate-y-0.5 transition-all">
          🚀 {t('nav.projects')}
        </a>
        <a href="/zh/about" class="px-6 py-3 rounded-2xl bg-white text-ink font-semibold border border-coral/20 shadow-sm hover:border-coral/40 hover:-translate-y-0.5 transition-all">
          👋 {t('nav.about')}
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  {posts.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">
          <span class="text-coral">📝</span> {t('home.latestPosts')}
        </h2>
        <a href="/zh/blog" class="text-sm font-medium text-mint hover:text-coral transition-colors">
          {t('home.viewAll')} →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => <BlogCard post={post} lang={lang} />)}
      </div>
    </section>
  )}

  <!-- 精选项目 -->
  {featuredProjects.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">
          <span class="text-mint">🚀</span> {t('home.featuredProjects')}
        </h2>
        <a href="/zh/projects" class="text-sm font-medium text-mint hover:text-coral transition-colors">
          {t('home.viewAll')} →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </section>
  )}

  <!-- 连接区 -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center p-10 rounded-3xl bg-gradient-to-br from-coral/10 via-sunshine/10 to-mint/10 border border-coral/10">
      <h2 class="text-2xl font-bold mb-4">{t('home.connectWithMe')}</h2>
      <p class="text-ink-soft mb-6">👋 {siteConfig.about.zh.split('\n')[0]}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-ink text-white font-medium hover:bg-coral transition-all">
            GitHub
          </a>
        )}
        {siteConfig.social.email && (
          <a href={siteConfig.social.email} class="px-5 py-2.5 rounded-xl bg-white text-ink font-medium border border-coral/20 hover:border-coral/40 transition-all">
            Email
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
