---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations, getLangFromUrl, langPrefix } from '../../i18n/utils';
import { siteConfig } from '../../data/site';
import { getFeaturedProjects } from '../../data/projects';

const lang = getLangFromUrl(Astro.url) as 'zh' | 'en';
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = getFeaturedProjects();
const name = siteConfig.name.en;
const tagline = siteConfig.tagline.en;
---

<BaseLayout title={`${name} · ${tagline}`} description={tagline}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute top-10 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
    <!-- Scattered bellflowers and waves -->
    <div class="absolute top-20 right-20 text-3xl animate-sway opacity-60 hidden sm:block">🔔</div>
    <div class="absolute bottom-32 left-16 text-2xl animate-float opacity-50 hidden sm:block">🌊</div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-32 text-center">
      <!-- Floating white cat -->
      <div class="text-7xl mb-6 animate-float">🐱</div>

      <p class="text-lg text-ink-soft mb-2">{t('home.greeting')}</p>

      <h1 class="text-5xl sm:text-7xl font-extrabold gradient-text mb-6">
        {name}
      </h1>

      <p class="text-xl sm:text-2xl text-ink-soft max-w-2xl mx-auto mb-4">
        {tagline}
      </p>

      <p class="text-base text-ink-soft/70 mb-12">
        {t('home.welcome')}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={`${langPrefix(lang)}/blog`} class="px-6 py-3 rounded-2xl bg-primary text-white font-semibold shadow-lg shadow-primary/30 hover:shadow-xl hover:shadow-primary/40 hover:-translate-y-0.5 transition-all">
          📝 {t('nav.blog')}
        </a>
        <a href={`${langPrefix(lang)}/projects`} class="px-6 py-3 rounded-2xl bg-accent text-white font-semibold shadow-lg shadow-accent/30 hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-0.5 transition-all">
          🌊 {t('nav.projects')}
        </a>
        <a href={`${langPrefix(lang)}/about`} class="px-6 py-3 rounded-2xl bg-white text-ink font-semibold border border-primary/20 shadow-sm hover:border-primary/40 hover:-translate-y-0.5 transition-all">
          🐾 {t('nav.about')}
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  {posts.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">
          <span class="text-primary">🔔</span> {t('home.latestPosts')}
        </h2>
        <a href={`${langPrefix(lang)}/blog`} class="text-sm font-medium text-accent hover:text-primary transition-colors">
          {t('home.viewAll')} →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => <BlogCard post={post} lang={lang} />)}
      </div>
    </section>
  )}

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold">
          <span class="text-accent">🌊</span> {t('home.featuredProjects')}
        </h2>
        <a href={`${langPrefix(lang)}/projects`} class="text-sm font-medium text-accent hover:text-primary transition-colors">
          {t('home.viewAll')} →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </section>
  )}

  <!-- Connect Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center p-10 rounded-3xl bg-gradient-to-br from-primary/10 via-bellflower/10 to-accent/10 border border-primary/10">
      <div class="text-4xl mb-4">🐱 🐚 🌊</div>
      <h2 class="text-2xl font-bold mb-4">{t('home.connectWithMe')}</h2>
      <p class="text-ink-soft mb-6">🐾 {siteConfig.about.en.split('\n')[0]}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-ink text-white font-medium hover:bg-primary transition-all">
            GitHub
          </a>
        )}
        {siteConfig.social.email && (
          <a href={siteConfig.social.email} class="px-5 py-2.5 rounded-xl bg-white text-ink font-medium border border-primary/20 hover:border-primary/40 transition-all">
            Email
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
