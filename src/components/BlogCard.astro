---
// BlogCard - blog post card
import { useTranslations, formatDate, langPrefix } from '../i18n/utils';

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, tags } = post.data;

const rawId = post.id.replace(/^(zh|en)\//, '');
const href = `${langPrefix(lang)}/blog/${rawId}`;
---

<a href={href} class="group block">
  <article class="h-full p-6 bg-white rounded-2xl shadow-sm border border-primary/5 hover:shadow-xl hover:border-primary/20 hover:-translate-y-1 transition-all duration-300">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-accent/15 text-accent">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <h3 class="text-lg font-bold text-ink group-hover:text-primary transition-colors mb-2 line-clamp-2">
      {title}
    </h3>

    <p class="text-sm text-ink-soft line-clamp-2 mb-4">
      {description}
    </p>

    <div class="text-xs text-ink-soft">
      {t('blog.publishedOn')} {formatDate(pubDate, lang)}
    </div>
  </article>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
