---
// Footer - social links + copyright
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { siteConfig } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
  { href: siteConfig.social.github, icon: 'github', label: 'GitHub' },
  { href: siteConfig.social.email, icon: 'email', label: 'Email' },
  { href: siteConfig.social.twitter, icon: 'twitter', label: 'Twitter' },
  { href: siteConfig.social.linkedin, icon: 'linkedin', label: 'LinkedIn' },
  { href: siteConfig.social.instagram, icon: 'instagram', label: 'Instagram' },
].filter((s) => s.href !== '');
---

<footer class="mt-20 border-t border-primary/15 bg-warmwhite">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- 社交链接 -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
      {socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary hover:bg-primary hover:text-white transition-all"
          aria-label={s.label}
          title={s.label}
        >
          {s.icon === 'github' && (
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 21.8 24 17.31 24 12c0-6.63-5.37-12-12-12z"/></svg>
          )}
          {s.icon === 'email' && (
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          )}
          {s.icon === 'twitter' && (
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          )}
          {s.icon === 'linkedin' && (
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56z"/></svg>
          )}
          {s.icon === 'instagram' && (
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          )}
        </a>
      ))}
    </div>

    <!-- 版权 -->
    <div class="text-center text-sm text-ink-soft">
      <p>
        © {siteConfig.year} {lang === 'zh' ? siteConfig.name.zh : siteConfig.name.en} · {t('footer.madeWith')}
      </p>
    </div>
  </div>
</footer>
