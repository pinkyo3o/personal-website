---
// Header - nav bar + language switch
import { getLangFromUrl, useTranslations, switchLangPath, langPrefix } from '../i18n/utils';
import { siteConfig } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const isActive = (key) => {
  const segment = `${langPrefix(lang)}/${key}`;
  return currentPath === segment || currentPath.startsWith(segment + '/');
};

const navItems = [
  { key: 'home', href: langPrefix(lang), label: t('nav.home'), icon: '🐱' },
  { key: 'about', href: `${langPrefix(lang)}/about`, label: t('nav.about'), icon: '🌷' },
  { key: 'blog', href: `${langPrefix(lang)}/blog`, label: t('nav.blog'), icon: '✍️' },
  { key: 'projects', href: `${langPrefix(lang)}/projects`, label: t('nav.projects'), icon: '🌊' },
];

const langSwitchHref = switchLangPath(Astro.url.pathname, lang === 'zh' ? 'en' : 'zh');
const displayName = lang === 'zh' ? siteConfig.name.zh : siteConfig.name.en;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-warmwhite/80 border-b border-primary/15">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo / 名字 -->
    <a href={langPrefix(lang)} class="text-lg font-bold gradient-text hover:opacity-80 transition-opacity">
      🐱 {displayName}
    </a>

    <!-- 导航链接 -->
    <ul class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-xl text-sm font-medium transition-all',
              isActive(item.key)
                ? 'bg-primary/20 text-primary'
                : 'text-ink-soft hover:bg-primary/10 hover:text-primary',
            ]}
          >
            <span class="hidden sm:inline">{item.icon}</span>
            <span class="ml-0.5 sm:ml-1">{item.label}</span>
          </a>
        </li>
      ))}

      <!-- 语言切换 -->
      <li>
        <a
          href={langSwitchHref}
          class="ml-1 px-3 py-2 rounded-xl text-sm font-bold bg-accent/20 text-ocean hover:bg-accent/30 transition-all"
        >
          {t('nav.langSwitch')}
        </a>
      </li>
    </ul>
  </nav>
</header>
